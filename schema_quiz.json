{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ALSM Quiz Question Schema",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "questiontext"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "multichoice",
              "truefalse",
              "matching",
              "gapselect",
              "ddwtos",
              "shortanswer",
              "calculatedsimple"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "nhan_biet",
              "thong_hieu",
              "van_dung",
              "van_dung_cao"
            ]
          },
          "metadata_code": {
            "type": "string"
          },
          "questiontext": {
            "type": "string"
          },
          "generalfeedback": {
            "type": "string"
          },
          "imgs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "fraction"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "fraction": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}